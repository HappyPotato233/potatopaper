# ================= 数据库（MySQL 8） =================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=literature_radar

# ================= JWT =================
JWT_SECRET_KEY=change-me-in-production-9f8e7d6c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================= 管理员初始化（首次启动时若无 admin 账号则自动创建） =================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy

# ================= LLM 引导配置（模型池为空时写入默认模型，OpenAI 兼容） =================
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL_NAME=glm-5.2

# ================= Tavily 网络检索（可选，留空则该路降级为空结果） =================
TAVILY_API_KEY=

# ================= Semantic Scholar（可选，提升限速额度） =================
S2_API_KEY=
